# Acceso a la aplicación
VIGIA_ADMIN_USER=admin
VIGIA_ADMIN_PASSWORD=cambia-esta-contrasena
VIGIA_SESSION_SECRET=genera-un-secreto-aleatorio-de-64-caracteres
VIGIA_SESSION_TTL_SECONDS=28800
# Activa true cuando la aplicación se publique exclusivamente con HTTPS.
VIGIA_COOKIE_SECURE=false

# Fuente oficial de datos
# auto usa HTTP cuando SEGUIMIENTO_FINANCIERO_URL existe; de lo contrario usa JSON.
VIGIA_DATA_PROVIDER=auto
VIGIA_BI_SNAPSHOT_PATH=data/bi_snapshot.json
SEGUIMIENTO_FINANCIERO_URL=
# URL privada opcional usada exclusivamente para planilla individual.
SEGUIMIENTO_FINANCIERO_SENSITIVE_URL=
SEGUIMIENTO_FINANCIERO_TOKEN=
SEGUIMIENTO_FINANCIERO_API_KEY=
# Para la API Docker local del proyecto seguimiento_financiero:
# SEGUIMIENTO_FINANCIERO_URL=http://host.docker.internal:3000/api/external
# VIGIA_ALLOW_INSECURE_DATA_URL=true
# Solo para una red Docker privada y controlada:
# VIGIA_ALLOW_INSECURE_SENSITIVE_DATA_URL=true
# Busca automáticamente el último período con información.
SEGUIMIENTO_FINANCIERO_LOOKBACK_MONTHS=24
# La base actual inicia en 2023-11; 36 meses cubren todo el histórico disponible.
VIGIA_FINANCIAL_HISTORY_MONTHS=36
VIGIA_DATA_REFRESH_SECONDS=60
# Para HTTP el valor por defecto es 900 (15 minutos). Cero desactiva el control.
# VIGIA_DATA_MAX_AGE_SECONDS=900
VIGIA_DATA_TIMEOUT_SECONDS=5
VIGIA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Política de intervención
VIGIA_INTERVENTION_COOLDOWN_SECONDS=45
VIGIA_EXECUTIVE_WRITER_ENABLED=true
VIGIA_EXECUTIVE_MODEL=gemini-2.5-flash
VIGIA_EXECUTIVE_TIMEOUT_MS=10000
# Cero prioriza una intervención breve e inmediata.
VIGIA_EXECUTIVE_THINKING_BUDGET=0

# Google Speech-to-Text
GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-speech.json
GOOGLE_SPEECH_LANGUAGE=es-PE
GOOGLE_SPEECH_MODEL=default
GOOGLE_SPEECH_HINT_BOOST=16

# Gemini solo redacta alertas ya validadas y genera voz.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VOICE=Orus
VIGIA_CONVERSATIONAL_ENABLED=false
VIGIA_CONVERSATIONAL_MODEL=gemini-2.5-flash
# Cero prioriza respuestas conversacionales inmediatas.
VIGIA_CONVERSATIONAL_THINKING_BUDGET=0
VIGIA_LIVE_ENABLED=false
VIGIA_LIVE_MODEL=gemini-3.1-flash-live-preview
VIGIA_LIVE_VOICE=Achernar
VIGIA_LIVE_THINKING_BUDGET=0
# gemini-cloud requiere aiplatform.endpoints.predict (roles/aiplatform.user).
VIGIA_TTS_PROVIDER=gemini-cloud
VIGIA_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
VIGIA_GEMINI_TTS_VOICE=Achernar
VIGIA_GEMINI_TTS_LANGUAGE=es-419
# native evita una segunda síntesis y prioriza conversación inmediata.
VIGIA_LIVE_PLAYBACK=native

# Preparado para persistencia futura.
DATABASE_URL=postgresql://vigia:vigia@127.0.0.1:5432/vigia
REDIS_URL=redis://127.0.0.1:6379/0
